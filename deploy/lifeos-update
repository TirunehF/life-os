#!/usr/bin/env bash
# Update Life OS to the newest tested commit of its repository.
#
#   sudo lifeos-update          update now
#   sudo lifeos-update --auto   same, for the timer: says nothing unless it
#                               changes something, and does not report failure
#                               when the repository cannot be reached
#
# "Tested": the repository's Tests workflow moves the branch "tested" to a
# commit of main once all tests have passed for it. A repository without that
# branch is followed on main.
#
# Fast-forward only. After the restart the service must answer api/health
# with the new commit; if it does not, the previous commit is restored.
set -euo pipefail

main() {
  local code=/opt/lifeos env_file=/etc/lifeos/lifeos.env venv=/opt/lifeos/venv
  local auto=no port old new refs tested latest branch
  local failed_file=$code/.git/lifeos-update-failed
  if [ "${1:-}" = --auto ]; then auto=yes; fi
  [ "$(id -u)" -eq 0 ] || { echo "Run with sudo." >&2; exit 1; }
  [ -d "$code/.git" ] || { echo "Life OS is not installed in $code." >&2; exit 1; }
  port=$(sed -n 's/^LIFEOS_PORT=//p' "$env_file" 2>/dev/null | tail -n 1)
  port=${port:-8787}
  cd "$code"

  old=$(git rev-parse HEAD)
  # One small question to the repository: where are "tested" and "main" now?
  if ! refs=$(git ls-remote origin refs/heads/tested refs/heads/main 2>/dev/null); then
    unreachable
  fi
  tested=$(printf '%s\n' "$refs" | awk '$2 == "refs/heads/tested" { print $1 }')
  latest=$(printf '%s\n' "$refs" | awk '$2 == "refs/heads/main" { print $1 }')
  branch=main
  if [ -n "$tested" ]; then branch=tested; fi
  new=${tested:-$latest}
  [ -n "$new" ] || { echo "$(git remote get-url origin) has no main branch; not updating." >&2; exit 1; }
  if [ "$old" = "$new" ]; then
    nothing_to_do "Already up to date (${old:0:12})."
  fi
  # The timer does not try a commit again that it had to roll back; you can.
  if [ "$auto" = yes ] && [ "$(cat "$failed_file" 2>/dev/null)" = "$new" ]; then exit 0; fi

  git fetch --quiet origin "$branch" 2>/dev/null || unreachable
  new=$(git rev-parse FETCH_HEAD)
  if [ "$old" = "$new" ]; then
    nothing_to_do "Already up to date (${old:0:12})."
  fi
  if git merge-base --is-ancestor "$new" "$old"; then
    nothing_to_do "The installed commit ${old:0:12} is newer than the tested one (${new:0:12}); nothing to do."
  fi
  if ! git merge-base --is-ancestor "$old" "$new"; then
    echo "The repository's $branch branch does not continue from the installed commit ${old:0:12}; not updating." >&2
    exit 1
  fi

  echo "Updating ${old:0:12} -> ${new:0:12}"
  checkout "$old" "$new"
  systemctl restart lifeos.service
  if healthy "$new"; then
    echo "Life OS is running commit ${new:0:12}."
    rm -f "$failed_file"
    if ! git diff --quiet "$old" "$new" -- deploy; then
      echo "The install files changed too. To apply them: sudo $code/deploy/install.sh"
    fi
    exit 0
  fi

  echo "The new version did not come up healthy; going back to ${old:0:12}." >&2
  printf '%s\n' "$new" > "$failed_file"
  checkout "$new" "$old"
  systemctl restart lifeos.service
  if healthy "$old"; then
    echo "Rolled back. Life OS is running commit ${old:0:12} again." >&2
  else
    echo "The previous version is not healthy either. Look at: journalctl -u lifeos -n 50" >&2
  fi
  exit 1
}

# The repository did not answer. For the timer that is not an error: it asks
# again in a few minutes.
unreachable() {
  if [ "$auto" = yes ]; then exit 0; fi
  echo "Could not reach $(git remote get-url origin); staying on ${old:0:12}." >&2
  exit 1
}

# Nothing to install. Says so, except to the timer.
nothing_to_do() {
  if [ "$auto" != yes ]; then
    echo "$1"
    if [ -n "$tested" ] && [ -n "$latest" ] && [ "$latest" != "$tested" ]; then
      echo "main is at ${latest:0:12}, which has not passed the tests (yet)."
    fi
  fi
  exit 0
}

# Move the working tree from commit $1 to commit $2 and install changed packages.
checkout() {
  git reset --quiet --hard "$2"
  chown -R root:root "$code"
  chmod -R u+rwX,go+rX,go-w "$code"
  if ! "$venv/bin/python" -c 'import sys' >/dev/null 2>&1; then
    rm -rf "$venv"
    python3 -m venv "$venv" >/dev/null 2>&1 || python3 -m venv --without-pip "$venv"
  fi
  if ! git diff --quiet "$1" "$2" -- server/requirements.txt \
     && grep -Eqv '^[[:space:]]*(#|$)' server/requirements.txt; then
    "$venv/bin/pip" install --quiet --no-input --disable-pip-version-check -r server/requirements.txt
  fi
}

# True once api/health answers ok with the expected commit.
healthy() {
  local expected=${1:0:12}
  for _ in $(seq 1 30); do
    if "$venv/bin/python" - "$port" "$expected" <<'PY' 2>/dev/null
import json, sys, urllib.request
with urllib.request.urlopen("http://127.0.0.1:%s/api/health" % sys.argv[1], timeout=3) as resp:
    body = json.load(resp)
sys.exit(0 if body.get("ok") and body.get("commit") == sys.argv[2] else 1)
PY
    then return 0; fi
    sleep 1
  done
  return 1
}

# The whole file is parsed before anything runs, so replacing it mid-update is safe.
main "$@"
exit
