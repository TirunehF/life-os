[Unit]
Description=Life OS: check for an update after each boot and once a night
Documentation=https://github.com/TirunehF/life-os

[Timer]
# A timer, not a boot dependency: nothing else waits for this at start-up.
OnBootSec=90s
# Nightly as well, for machines that stay up; after the 03:30 snapshot.
OnCalendar=*-*-* 04:15:00
AccuracySec=10s

[Install]
WantedBy=timers.target
