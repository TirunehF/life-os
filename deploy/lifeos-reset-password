#!/usr/bin/env bash
# Forgot the password? This clears the password, the pattern and every device
# session, so the setup screen appears again. The journal data is not touched.
#
#   sudo lifeos-reset-password
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "Run with sudo." >&2; exit 1; }
data=$(sed -n 's/^LIFEOS_DATA=//p' /etc/lifeos/lifeos.env 2>/dev/null | tail -n 1)
data=${data:-/var/lib/lifeos}

if [ "${1:-}" != --yes ]; then
  printf 'Clear the Life OS password, pattern and all sign-ins? The data is kept. [y/N] '
  read -r answer
  case "$answer" in y|Y|yes|YES) ;; *) echo "Nothing changed."; exit 0 ;; esac
fi

cd /opt/lifeos/server
runuser -u lifeos -- env LIFEOS_DATA="$data" PYTHONDONTWRITEBYTECODE=1 \
  /opt/lifeos/venv/bin/python -m lifeos.admin reset-auth
echo "Open Life OS and choose a new password now: until you do, the first visitor chooses it."
